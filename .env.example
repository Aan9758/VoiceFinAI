# Optional speech recognition. Audio is sent to Deepgram when voice is enabled.
DEEPGRAM_API_KEY=

# Optional template generation providers. Prompts include the user question,
# selected fund facts, and short conversation context.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
VOICEFINAI_MODEL=claude-sonnet-4-6

# Natural speech output. ElevenLabs requires an API key and a voice your account can use.
# When both ElevenLabs values are set, ElevenLabs is selected automatically.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Edge TTS demo fallback only.
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+5%
TTS_FALLBACK_VOICE=hi-IN-MadhurNeural
